{
  "name": "@bunny.net/astro-adapter",
  "version": "0.1.0",
  "description": "Astro adapter for bunny.net Edge Scripting. Renders Astro on the edge and serves the build assets from Bunny Storage.",
  "type": "module",
  "license": "MIT",
  "author": "bunny.net",
  "homepage": "https://bunny.net/docs/scripting/frameworks/astro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BunnyWay/bunny-adapters.git",
    "directory": "packages/astro"
  },
  "bugs": "https://github.com/BunnyWay/bunny-adapters/issues",
  "keywords": [
    "astro-adapter",
    "astro",
    "astro-component",
    "bunny",
    "bunny.net",
    "bunnycdn",
    "edge-scripting",
    "edge",
    "ssr",
    "withastro"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./image-service": {
      "types": "./dist/image-service.d.ts",
      "default": "./dist/image-service.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./local-zone": {
      "types": "./dist/build/local-zone.d.ts",
      "default": "./dist/build/local-zone.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "lint:package": "publint --strict && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bunny.net/edgescript-sdk": "^0.12.1",
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@types/node": "^26.2.0",
    "astro": "^7.2.3",
    "publint": "^0.3.0",
    "typescript": "^5.7.0"
  }
}
